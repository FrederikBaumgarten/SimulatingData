\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Step 2: simulate the data the model implies}{9}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Step 2 of the loop for the linear example. (a) Data simulated from Equation\nobreakspace  {}\ref {eq:linear} with $a = 30$, $b = 7$, $\sigma = 5$ and $n = 50$: the hypothesis in visual form, showing effect size and scatter together. (b) The fitted model (solid) against the generating model (dashed). (c) The estimated slope and its 95\% interval. The length of this bar is the quantity the rest of the section is about.\relax }}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:fakedata}{{1}{9}{Step 2 of the loop for the linear example. (a) Data simulated from Equation~\ref {eq:linear} with $a = 30$, $b = 7$, $\sigma = 5$ and $n = 50$: the hypothesis in visual form, showing effect size and scatter together. (b) The fitted model (solid) against the generating model (dashed). (c) The estimated slope and its 95\% interval. The length of this bar is the quantity the rest of the section is about.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Step 3: how precision responds to design}{10}{subsection.3.3}\protected@file@percent }
\citation{gelmanPowerCalculationsAssessing2014}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Step 3: how the precision of the nitrogen effect responds to design choices. (a) Design-precision curve: mean and 80th percentile of the 95\% interval width against sample size. (b) At a single design ($n = 50$) the width is itself a random variable; the mean is a poor target because about half of realised studies fall beyond it. (c) The simulated curve reproduces the closed-form result, validating the machinery before it is used where no formula exists. (d) At fixed $n = 50$, spreading the predictor more widely improves precision markedly. (e) Doubling the residual SD costs roughly a fourfold increase in sample size.\relax }}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:precision}{{2}{11}{Step 3: how the precision of the nitrogen effect responds to design choices. (a) Design-precision curve: mean and 80th percentile of the 95\% interval width against sample size. (b) At a single design ($n = 50$) the width is itself a random variable; the mean is a poor target because about half of realised studies fall beyond it. (c) The simulated curve reproduces the closed-form result, validating the machinery before it is used where no formula exists. (d) At fixed $n = 50$, spreading the predictor more widely improves precision markedly. (e) Doubling the residual SD costs roughly a fourfold increase in sample size.\relax }{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}From a scientific requirement to a sample size}{11}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Choosing a sample size from a precision requirement. The curve shows the 80th percentile of the 95\% interval width for $b$; the horizontal line is the target width of $0.5$ implied by a requirement of $\pm 0.25$. The two meet at $n \approx 120$.\relax }}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:target}{{3}{11}{Choosing a sample size from a precision requirement. The curve shows the 80th percentile of the 95\% interval width for $b$; the horizontal line is the target width of $0.5$ implied by a requirement of $\pm 0.25$. The two meet at $n \approx 120$.\relax }{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}What an imprecise design would do to our conclusions}{11}{subsection.3.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The distribution of slope estimates from 4000 simulated studies with $b = 0.5$, $\sigma = 15$ and $n = 20$ (grey), and the subset that would reach $p < 0.05$ and so be most likely to be reported (dark). Conditional on significance, the design exaggerates the effect roughly fourfold and returns the wrong sign about 7\% of the time. The dashed line is the true value.\relax }}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:typesm}{{4}{12}{The distribution of slope estimates from 4000 simulated studies with $b = 0.5$, $\sigma = 15$ and $n = 20$ (grey), and the subset that would reach $p < 0.05$ and so be most likely to be reported (dark). Conditional on significance, the design exaggerates the effect roughly fourfold and returns the wrong sign about 7\% of the time. The dashed line is the true value.\relax }{figure.caption.9}{}}
