\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Estimates of $K$ and $V_{\max }$ from 500 simulated studies under each design, with the true values marked. (a) Under the narrow design the two parameters trade off against one another and neither is well determined. (b) Under the wide design both are recovered. Non-converged fits are excluded; their frequency is reported in the text.\relax }}{14}{figure.caption.11}\protected@file@percent }
\newlabel{fig:mmcloud}{{6}{14}{Estimates of $K$ and $V_{\max }$ from 500 simulated studies under each design, with the true values marked. (a) Under the narrow design the two parameters trade off against one another and neither is well determined. (b) Under the wide design both are recovered. Non-converged fits are excluded; their frequency is reported in the text.\relax }{figure.caption.11}{}}
