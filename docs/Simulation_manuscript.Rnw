	\newpage


\bibliography{Art_simulation}
\bibliographystyle{ecolett}


\begin{tcolorbox}[
	title=Box 1: Common pitfalls along the traditional scientific workflow,
	colback=black!2,
	colframe=black!35,
	fonttitle=\bfseries,
	boxrule=0.6pt,
	arc=2mm,
	left=2mm,right=2mm,top=1mm,bottom=1mm
	]
	
	\textit{This box summarises common pitfalls in roughly the order they can arise along the traditional workflow shown in Figure~1. The proposed simulation loop provides a tool to anticipate and prevent many of these pitfalls.}
	
	\vspace{4pt}
	\textbf{Identifying research question}
	
	\textbf{(1) Confirmation bias and motivated reasoning.}
	Interpreting evidence in ways that align with prior beliefs or preferred narratives.
	Refs: \citealt{nickersonConfirmationBiasUbiquitous1998, kundaCaseMotivatedReasoning1990, tverskyJudgmentUncertaintyHeuristics1974}.
	
	\textbf{(2) Weakly specified hypotheses and undefined alternatives.}
	Hypotheses may be vague, lack a clear direction or quantitative prediction, and the implied alternative to the null is often left undefined (e.g.\ “there is a difference”), which makes interpretation and design targets ambiguous.
	Refs: \citealt{rajtmajerHowFailureFalsify2022, gigerenzerMindlessStatistics2004, perezgonzalezFisherNeymanPearsonNHST2015}.
		
\textbf{(3) Confounding and causal overinterpretation of associations.}
A statistical association does not, by itself, identify a causal effect. Apparent treatment effects can arise because groups differ in other drivers (confounding), because sampling is selective, or because key variables were not measured. As a result, strong narratives can be attached to patterns that would also be expected under plausible alternative explanations.
Refs: \citealt{pearlSevenToolsCausal2019, rajtmajerHowFailureFalsify2022}.

	\vspace{4pt}
	\textbf{Study design}
	
	\textbf{(4) Insufficient sample sizes.}
	Small samples frequently yield imprecise estimates and unstable results, and can exaggerate effect sizes by chance.
	Refs: \citealt{halseyFickleValueGenerates2015, ioannidisWhyMostPublished2005a, baker500ScientistsLift2016, camererEvaluatingReplicabilitySocial2018}.
	
	\textbf{(5) Planning for “power to detect” rather than precision/relevance.}
	Sample size decisions that target a significance threshold rather than a decision-relevant interval width or estimation goal.
	Refs: \citealt{goodmanUsePredictedConfidence1994, rothmanPlanningStudySize2018, cummingUnderstandingNewStatistics2013}.
	
	\textbf{(6) Measurement error, imperfect detection, and misclassification.}
	Noise and bias introduced by measurement instruments, proxies, observer effects, or detection limits can attenuate effects, inflate uncertainty, or create spurious patterns if not anticipated and modeled.
	Refs: \citealt{direnzoPracticalGuideUnderstanding2023, popovicFourPrinciplesImproved2024}.
	
	\textbf{(7) Non-independence and pseudoreplication.}
	Spatial/temporal autocorrelation, clustering, and repeated measures can reduce the effective sample size and bias uncertainty if treated as independent.
	Refs: \citealt{direnzoPracticalGuideUnderstanding2023, popovicFourPrinciplesImproved2024}.
	
	\vspace{4pt}
	\textbf{Analysis}
	
	\textbf{(8) Overreliance on p-values and “statistical significance”.}
	Dichotomous interpretations substitute for effect sizes, uncertainty, and scientific relevance.
	Refs: \citealt{amrheinEarthFlat0052017, amrheinAbandoningStatisticalSignificance2019, wassersteinMovingWorld052019}.
	
	\textbf{(9) Multiple analysis choices: multiple testing, HARKing, and p-hacking.}
	Many defensible analysis choices and multiple comparisons can yield different outcomes; hypotheses may be adjusted after seeing results (HARKing), and selective exploration can create apparently strong results without deliberate misconduct.
	Refs: \citealt{gelmanGardenForkingPaths2013, stefanBigLittleLies2023, kerrHARKingHypothesizingResults1998}.
	
	\textbf{(10) Mismatch between model and data-generating process.}
	Inference can be distorted when key features of the data are ignored or misrepresented (e.g.\ non-linear relationships fit as linear, wrong distribution or link, omitted random effects, ignored autocorrelation, inappropriate pooling, or unmodelled measurement error).
	Refs: \citealt{direnzoPracticalGuideUnderstanding2023, popovicFourPrinciplesImproved2024}.
	
	\textbf{(11) Mathematical artefacts and scale/transform issues.}
	Patterns can arise from statistical artefacts (e.g.\ regression to the mean) or inappropriate transformations; these can mimic biological effects.
	Refs: \citealt{barnettRegressionMeanWhat2005, wolkovichSimpleExplanationDeclining2021a}.
	
	\vspace{4pt}
	\textbf{Interpretation \& Communication}
	
	\textbf{(12) Overconfident “yes/no” summaries.}
	Binary conclusions can sound decisive even when intervals are wide or model-dependent.
	Refs: \citealt{muffRewritingResultsSections2022, amrheinAbandoningStatisticalSignificance2019}.
	
	\textbf{(13) Misreading “non-significant” as “no effect”.}
	Non-significant results are often compatible with effects that are biologically meaningful but imprecisely estimated.
	Refs: \citealt{goodmanUsePredictedConfidence1994, rothmanPlanningStudySize2018, singalPrenatalAntidepressantUse2017a}.
	
	\textbf{(14) Selective reporting and publication bias (significance filtering).}
	Significant/tidy results are more likely to be emphasized and published, distorting the evidence base.
	Refs: \citealt{yangPublicationBiasImpacts2023, vanzwetSignificanceFilterWinners2021}.
	
\end{tcolorbox}



					\begin{figure}
	\centering
	\includegraphics[width=0.9\textwidth]{figure_1.pdf} 
	\caption{Schematic overview of the current scientific workflow (blue circle) with its related problems (red text) and how some of them can be anticipated with the help of data simulation (three-step-loop in yellow). The critical step is the translation of a verbal hypothesis into a mechanistic model expressed in mathematical terms. We believe that this 'simulation loop'  fosters a better understanding of underlying processes founded in theory, clear predictions that can be evaluated and overall better science. The questions summarized in the green box should be addressed in the simulation loop before continuing on the blue circle, e.g. prior to the start of real data gathering/exploration.}
	\label{fig:fig_1xxx}
\end{figure}






